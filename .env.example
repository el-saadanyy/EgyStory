# EgyStory Environment Variables Reference
# Copy this file to .env and configure your values

# ── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com,.containers.snapdeploy.app,.snapdeploy.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com,https://*.containers.snapdeploy.app,https://*.snapdeploy.app

# ── Server & Runtime Tuning (Render Free 512 MB RAM) ────────────────────────
PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2

# ── Database Configuration ──────────────────────────────────────────────────
# Default: SQLite (leave empty to use local db.sqlite3)
# External PostgreSQL (e.g. Neon, Supabase, Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Connection management tuning (persistent pool):
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=True

# Or individual DB fields (fallback):
# DB_NAME=egystory
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ── Cloud Object Storage (Media Files / Uploads) ─────────────────────────────
# Default: Local storage (serves demo media directly from container/disk)
# NOTE: New user uploads to local storage are ephemeral on Render Free.
# Persistent cloud object storage (AWS S3 / Cloudflare R2) can be enabled later:
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com

# ── Email Settings ──────────────────────────────────────────────────────────
# NOTE: Render Free Web Services completely block outbound SMTP ports (25, 465, 587).
# Use Resend HTTP Email API (HTTPS / port 443 - no custom domain required):
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Alternative HTTP email provider:
# BREVO_API_KEY=

# Traditional SMTP (Only for environments where outbound SMTP is allowed, e.g. local):
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# ── Demo Account Setup (Portfolio Demo) ──────────────────────────────────────
# Set to 'true' to enable demo account initialization:
INIT_DEMO_ACCOUNTS=true
DEMO_USER_EMAIL=demo@egystory.com
# Passwords must be provided via environment variables (skipped if empty):
DEMO_USER_PASSWORD=
DEMO_REVIEWER_EMAIL=reviewer@egystory.com
DEMO_REVIEWER_PASSWORD=

# ── Chatbot Assistant ───────────────────────────────────────────────────────
GEMINI_API_KEY=
