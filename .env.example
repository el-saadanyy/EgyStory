# EgyStory Environment Variables
# Copy this file to .env and fill in your values

SECRET_KEY=your-secret-key-here
DEBUG=True
DB_NAME=egystory
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# Gemini AI API Key for Chatbot Assistant
GEMINI_API_KEY=

# Email Settings (Example: Mailtrap)
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_HOST_USER=your-mailtrap-user
# EMAIL_HOST_PASSWORD=your-mailtrap-password
# EMAIL_USE_TLS=True

# Email Settings (Example: Gmail SMTP)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

DEFAULT_FROM_EMAIL=noreply@egystory.com
