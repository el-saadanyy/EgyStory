# EgyStory Environment Variables
# Copy this file to .env and configure your values

# Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com

# Database Strategy
# Default: SQLite (leave empty to use default local db.sqlite3)
# For persistent volume (e.g. Render Persistent Disk mounted at /data):
# DATABASE_PATH=/data/db.sqlite3
# MEDIA_ROOT_PATH=/data/media

# For PostgreSQL (optional):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Or individual DB fields:
# DB_NAME=egystory
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# Gemini AI API Key for Chatbot Assistant
GEMINI_API_KEY=

# Email Settings
# Set EMAIL_BACKEND explicitly, or let EgyStory automatically use SMTP when credentials are provided
# and fallback safely to console backend when credentials are empty.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Real SMTP Provider (Gmail / Brevo / SendGrid / Mailtrap)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@egystory.com
